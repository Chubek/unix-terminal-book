\tcbset{utp listing/.style={enhanced,breakable,listing only,colback=UTPCode,colframe=UTPRule,colbacktitle=UTPSoft,coltitle=UTPInk,fonttitle=\small\sffamily\bfseries,boxrule=0.45pt,arc=1mm,left=2mm,right=2mm,top=1mm,bottom=1mm,before skip=0.75em,after skip=0.75em,listing options={style=utpcode}}}
\NewTCBListing{terminal}{!O{}}{utp listing,title={Terminal},#1}
