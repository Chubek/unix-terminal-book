\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{utp-headers}[2026/11/27 v1.0 Running heads and folios]
\RequirePackage{utp-colors}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\if@twoside
 \fancyhead[LE]{\small\sffamily\color{UTPMuted}\nouppercase{\leftmark}}
 \fancyhead[RO]{\small\sffamily\color{UTPMuted}\nouppercase{\rightmark}}
 \fancyfoot[LE,RO]{\sffamily\thepage}
\else
 \fancyhead[L]{\small\sffamily\color{UTPMuted}\nouppercase{\leftmark}}
 \fancyfoot[R]{\sffamily\thepage}
\fi
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter\enspace #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace #1}}
\endinput
