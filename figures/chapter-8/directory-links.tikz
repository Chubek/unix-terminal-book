\newcommand{\UTPEightTree}{%
\begin{tikzpicture}
\node[utp node] (a) at (0,0) {practice root};
\node[utp node] (b) at (-1.7,-1.2) {forms};
\node[utp node] (c) at (1.7,-1.2) {events};
\node[utp node] (d) at (.65,-2.4) {june};
\node[utp node] (e) at (2.75,-2.4) {july\\(next step)};
\draw[utp arrow] (a)--(b);
\draw[utp arrow] (a)--(c);
\draw[utp arrow] (c)--(d);
\draw[utp arrow,dashed] (c)--(e);
\end{tikzpicture}}
\newcommand{\UTPEightHard}{%
\begin{tikzpicture}
\node[utp node] (a) at (-2.4,0) {\texttt{forms/intake.txt}};
\node[utp node] (b) at (2.4,0) {\texttt{events/june/}\\\texttt{intake-same.txt}};
\node[utp node] (c) at (0,-1.45) {one file};
\draw[utp arrow] (a)--(c);
\draw[utp arrow] (b)--(c);
\end{tikzpicture}}
\newcommand{\UTPEightRoute}{%
\begin{tikzpicture}
\node[utp node] (a) {june};
\node[utp node,right=8mm of a] (b) {events};
\node[utp node,right=8mm of b] (c) {root};
\node[utp node,below=8mm of c] (d) {forms};
\node[utp node,left=8mm of d] (e) {\texttt{intake-master.txt}};
\draw[utp arrow] (a)--node[above,font=\small] {\texttt{..}}(b);
\draw[utp arrow] (b)--node[above,font=\small] {\texttt{..}}(c);
\draw[utp arrow] (c)--(d);
\draw[utp arrow] (d)--(e);
\end{tikzpicture}}
