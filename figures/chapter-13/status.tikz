\begin{tikzpicture}
\node[utp node] (status) {Status from \texttt{cmp}};
\node[utp node] (equal) at (-3,-1.5) {0: equal};
\node[utp node] (different) at (0,-1.5) {1: different};
\node[utp node] (trouble) at (3,-1.5) {Above 1: trouble};
\draw[utp arrow] (status.south west)--(equal.north);
\draw[utp arrow] (status)--(different);
\draw[utp arrow] (status.south east)--(trouble.north);
\end{tikzpicture}
