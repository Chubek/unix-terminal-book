\begin{figure}[htbp]
\centering
\begin{tikzpicture}[node distance=7mm and 8mm]
\node[utp node] (m) {\texttt{monday.txt}, line 1};
\node[utp node,below=of m] (t) {\texttt{thursday.txt}, line 1};
