\begin{tikzpicture}
  \node[utp node] (goal) at (0,0) {List all entries};
  \node[utp node] (short) at (3.6,.65) {\ttfamily ls -a};
  \node[utp node] (long) at (3.6,-.65) {\ttfamily ls --all};
  \node[utp node] (std) at (7.1,.65) {POSIX spelling};
  \node[utp node] (extra) at (7.1,-.65) {GNU spelling};
  \draw[utp arrow] (goal.east) -- (short.west);
  \draw[utp arrow] (goal.east) -- (long.west);
  \draw[utp arrow] (short) -- (std);
  \draw[utp arrow] (long) -- (extra);
\end{tikzpicture}
