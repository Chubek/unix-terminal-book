\begin{bookglossary}
\markboth{Glossary}{}
\GlossaryEntry{absolute-path}{Absolute path}{A pathname starting at the root directory rather than at the working directory.}
\GlossaryEntry{alias}{Alias}{A shell-defined shorthand that can replace a command word according to that shell's rules.}
\GlossaryEntry{argument}{Argument}{A separate value passed to a command, such as a switch or a pathname.}
\GlossaryEntry{archive}{Archive}{One file containing a collection of entries and associated metadata. An archive need not be compressed.}
\GlossaryEntry{backup}{Backup}{A retained copy from which data can be restored. A synchronized mirror alone may propagate deletions.}
\GlossaryEntry{builtin}{Builtin}{A command implemented by the shell itself.}
\GlossaryEntry{checksum}{Checksum}{A value calculated from data and used to check a copy against a trusted expected value. The algorithm determines what the check can establish.}
\GlossaryEntry{compression}{Compression}{Representing data in another form, usually to reduce its size.}
\GlossaryEntry{current-directory}{Current working directory}{The directory from which a relative pathname is looked up.}
\GlossaryEntry{descriptor}{File descriptor}{A process's numbered handle for an open file or other input/output resource.}
\GlossaryEntry{dns}{DNS}{The distributed naming system used, among other things, to look up addresses associated with hostnames.}
\GlossaryEntry{environment}{Environment}{Named values supplied to a process when it starts. A shell can export a variable into the environment of commands it runs.}
\GlossaryEntry{eof}{End of file (EOF)}{The condition that no more input is available from a file or stream. It is not normally a literal printable character in that file.}
\GlossaryEntry{exit-status}{Exit status}{A number reporting how a command finished. Zero conventionally denotes success; consult the command's manual for other values.}
\GlossaryEntry{expansion}{Expansion}{A shell's replacement of certain notation with values, text or matching pathnames before the command receives its arguments.}
\GlossaryEntry{glob}{Glob}{A pattern used to match names. The shell's filename expansion rules differ from a text search tool's regular expression rules.}
\GlossaryEntry{hard-link}{Hard link}{A directory entry referring to an existing file object. Removing one entry does not remove the other names for that object.}
\GlossaryEntry{home}{Home directory}{The directory associated with a user account, often the starting location for a new shell.}
\GlossaryEntry{host-key}{Host key}{A key by which an SSH server can prove its identity to a client that trusts the corresponding public key.}
\GlossaryEntry{job}{Job}{A shell's unit for tracking a launched command or pipeline. A job identifier is not a process ID.}
\GlossaryEntry{locale}{Locale}{Settings that influence such behavior as character classification, sorting, and the formatting of dates and numbers.}
\GlossaryEntry{operand}{Operand}{An input a command acts on, such as a file name or a search pattern.}
\GlossaryEntry{option}{Option}{An argument used to choose or change a command's behavior. A shell operator, by contrast, is interpreted by the shell.}
\GlossaryEntry{pager}{Pager}{A program that lets you read output one screenful at a time.}
\GlossaryEntry{path}{Pathname}{A sequence of names and slash separators that identifies a location in a filesystem.}
\GlossaryEntry{pipe}{Pipe}{A connection carrying bytes from a process's output to another process's input. A pipeline can have more than two stages.}
\GlossaryEntry{posix}{POSIX}{A family of standards for operating-system interfaces, including the shell language and common utilities.}
\GlossaryEntry{process}{Process}{A running instance of a program, identified by a process ID (PID).}
\GlossaryEntry{prompt}{Prompt}{Text displayed by an interactive interpreter when it is ready for input, or when it needs more input to finish an incomplete command.}
\GlossaryEntry{redirection}{Redirection}{Setting up a command's input or output to use a different source or destination.}
\GlossaryEntry{regex}{Regular expression}{A pattern language for matching text. Different implementations and modes can give a character different meanings.}
\GlossaryEntry{relative-path}{Relative path}{A pathname interpreted from a starting directory rather than from the root.}
\GlossaryEntry{restore}{Restore}{Recovering data from a backup. A restore drill checks that the necessary data can actually be read and recovered.}
\GlossaryEntry{root}{Root}{The top directory, written \texttt{/}, or the privileged account on Unix-like systems; the two meanings are unrelated in use.}
\GlossaryEntry{shell}{Shell}{An interpreter that reads shell commands and carries them out, often by running other programs.}
\GlossaryEntry{signal}{Signal}{An operating-system notification to a process, such as an interrupt or a request to terminate.}
\GlossaryEntry{stderr}{Standard error}{The conventional diagnostic output stream, normally file descriptor 2.}
\GlossaryEntry{stdin}{Standard input}{The default input stream, normally file descriptor 0.}
\GlossaryEntry{stdout}{Standard output}{The primary output stream, normally file descriptor 1.}
\GlossaryEntry{symlink}{Symbolic link}{An entry containing a path to another location. It can remain in place even when that location no longer exists.}
\GlossaryEntry{terminal}{Terminal}{The input and display interface used to interact with text-based programs. A terminal application is not the shell it hosts.}
\GlossaryEntry{unicode}{Unicode}{A standard assigning numbers to characters and defining related text properties. UTF-8 is one way of recording those numbers as bytes.}
\GlossaryEntry{utility}{Utility}{A command used to perform a task, such as listing files or comparing text.}
\end{bookglossary}
